# --- Database ---
DATABASE_URL=postgresql+asyncpg://hr_app:changeme@localhost:5432/hr_policy_assistant

# --- Vector Store ---
# Using pgvector inside the same Postgres instance (no separate service needed)
VECTOR_DIMENSION=1536

# --- LLM / Embeddings ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_API_KEY=
# If routing through a custom OpenAI-compatible gateway (e.g. Arshniv Labs
# key gateway), set its base URL here. Leave blank to call OpenAI directly.
LLM_BASE_URL=https://keygateeway1.arshnivlabs.com/v1

# --- Optional: LangSmith tracing ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hr-policy-assistant

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- RAG tuning ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.72

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
